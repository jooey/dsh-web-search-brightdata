{
	"name": "dsh-web-search-brightdata",
	"version": "1.0.1",
	"description": "DSH web plugin: Bright Data SERP API search provider for ctx.web with a managed multi-key pool (per-key add/remove/enable/test from Settings), zone config, rotation, and cooldown failover",
	"type": "module",
	"main": "lib/index.js",
	"license": "MIT",
	"author": "jooey",
	"keywords": [
		"dsh",
		"deepseek-harness",
		"brightdata",
		"web-search",
		"plugin"
	],
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./typert": "./lib/typert.host.js",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"install.sh",
		"README.md"
	],
	"peerDependencies": {
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/schemastery": "^3.18.1",
		"@deepseek-ai/dsh-web": "^0.1.0-rc.7",
		"@deepseek-ai/dsh-credentials": "^0.1.0-rc.7",
		"@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7"
	},
	"dsh": {
		"client": {
			"platform": "web"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jooey/dsh-web-search-brightdata.git"
	}
}
